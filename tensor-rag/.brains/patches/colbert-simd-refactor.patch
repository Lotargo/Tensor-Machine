+fn simd_dot_product(a: &[f32], b: &[f32]) -> f32 {
+    let len = a.len().min(b.len());
+    let mut sum = 0.0f32;
+    let mut i = 0;
+    while i + 4 <= len {
+        sum += a[i] * b[i]
+            + a[i + 1] * b[i + 1]
+            + a[i + 2] * b[i + 2]
+            + a[i + 3] * b[i + 3];
+        i += 4;
+    }
+    while i < len {
+        sum += a[i] * b[i];
+        i += 1;
+    }
+    sum
+}
