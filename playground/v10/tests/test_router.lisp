(require 'sb-bsd-sockets)
(load "router/protocol.lisp")
(load "router/safe_eval.lisp")
(load "router/server.lisp")

(defun test-crc16 ()
  (format t "Testing CRC16...~%")
  (let ((data #(1 4 0 0 0 97 98 99 100)))
    (assert (not (= (tcbp:crc16 data) 0)))))

(defun test-pack-unpack-32 ()
  (format t "Testing Pack/Unpack UInt32...~%")
  (let* ((val #x12345678)
         (packed (tcbp:pack-uint32-le val))
         (unpacked (tcbp:unpack-uint32-le packed 0)))
    (assert (= val unpacked))))

(defun test-pack-unpack-16 ()
  (format t "Testing Pack/Unpack UInt16...~%")
  (let* ((val #xABCD)
         (packed (tcbp:pack-uint16-le val))
         (unpacked (tcbp:unpack-uint16-le packed 0)))
    (assert (= val unpacked))))

(defun test-float64 ()
  (format t "Testing Float64 to Bytes...~%")
  (let* ((val 3.14159d0)
         (bytes (tcbp:double-to-bytes val))
         (unpacked (tcbp:bytes-to-double bytes 0)))
    (assert (= val unpacked))))

(defun test-matrix-payload ()
  (format t "Testing Matrix Payload...~%")
  (let* ((dims #(2 2))
         (data #(1.0d0 2.0d0 3.0d0 4.0d0))
         (payload (tcbp:pack-matrix-payload dims data))
         (parsed (tcbp:parse-matrix-payload payload))
         (parsed-dims (first parsed))
         (parsed-data (second parsed)))
    (assert (equalp dims parsed-dims))
    (assert (equalp data parsed-data))))

(defun test-safe-eval ()
  (format t "Testing Safe Eval Math Correctness...~%")
  (let ((res1 (safe-eval:evaluate "(+ 2 2)"))
        (res2 (safe-eval:evaluate "(* (+ 2 3) 4)"))
        (res3 (safe-eval:evaluate "(- 10 (/ 20 2))")))
    (assert (= res1 4))
    (assert (= res2 20))
    (assert (= res3 0))))

(defun test-matrix-math ()
  (format t "Testing Matrix Math Execution on Network Payload...~%")
  (let* ((dims #(2 2))
         ;; [1 2]
         ;; [3 4]
         (data #(1.0d0 2.0d0 3.0d0 4.0d0))
         (res (tcbp-server::matrix-multiply dims data)))
    ;; Matmul logic squares it:
    ;; 1*1 + 2*3 = 7
    ;; 1*2 + 2*4 = 10
    ;; 3*1 + 4*3 = 15
    ;; 3*2 + 4*4 = 22
    (assert (= (aref res 0) 7.0d0))
    (assert (= (aref res 1) 10.0d0))
    (assert (= (aref res 2) 15.0d0))
    (assert (= (aref res 3) 22.0d0))))

(defun test-sym ()
  (format t "Testing Symbolic Differentiation...~%")
  (let ((res (safe-eval:differentiate "(* x x)" "x")))
    ;; should simplify to (* 2 x) or (+ x x)
    ;; In our naive implementation diff of (* x x) -> (+ (* 1 x) (* x 1)) -> (+ x x)
    (assert (string= res "(+ X X)"))))

(defun test-graph ()
  (format t "Testing Dijkstra (GRAPH)...~%")
  (let* ((num-nodes 3)
         (row-ptrs #(0 2 3 3))
         (col-indices #(1 2 2))
         (data #(1.0d0 4.0d0 2.0d0))
         (source 0)
         (res (tcbp-graph:dijkstra num-nodes row-ptrs col-indices data source))
         (dist (first res)))
    (assert (= (aref dist 0) 0.0d0))
    (assert (= (aref dist 1) 1.0d0))
    (assert (= (aref dist 2) 3.0d0)))) ; path 0 -> 1 -> 2 has weight 1 + 2 = 3

(defun test-dsp ()
  (format t "Testing DFT (DSP)...~%")
  (let* ((num-elems 4)
         (real-parts #(1.0d0 0.0d0 -1.0d0 0.0d0)) ; a simple cosine
         (imag-parts #(0.0d0 0.0d0 0.0d0 0.0d0))
         (res (tcbp-dsp:dft num-elems real-parts imag-parts))
         (out-real (first res))
         (out-imag (second res)))
    ;; dft of cos should give peaks
    (assert (< (abs (- (aref out-real 0) 0.0d0)) 1e-9))
    (assert (< (abs (- (aref out-real 1) 2.0d0)) 1e-9))
    (assert (< (abs (- (aref out-real 2) 0.0d0)) 1e-9))
    (assert (< (abs (- (aref out-real 3) 2.0d0)) 1e-9))))

(defun test-qsim ()
  (format t "Testing QSIM Hadamard...~%")
  (let* ((num-states 2)
         (state-complex (make-array num-states :element-type '(complex long-float) :initial-element #C(0.0l0 0.0l0)))
         (_ (setf (aref state-complex 0) #C(1.0l0 0.0l0)))
         (res (tcbp-qsim:apply-gate "H" state-complex 0 0 1))
         (inv-sqrt-2 (coerce (/ 1.0 (sqrt 2.0)) 'long-float)))
    (declare (ignore _))
    (assert (< (abs (- (realpart (aref res 0)) inv-sqrt-2)) 1e-7))
    (assert (< (abs (- (realpart (aref res 1)) inv-sqrt-2)) 1e-7))))

(defun run-tests ()
  (test-crc16)
  (test-pack-unpack-32)
  (test-pack-unpack-16)
  (test-float64)
  (test-matrix-payload)
  (test-safe-eval)
  (test-matrix-math)
  (test-sym)
  (test-graph)
  (test-dsp)
  (test-qsim)
  (format t "Lisp Router Tests Passed.~%"))

(run-tests)
