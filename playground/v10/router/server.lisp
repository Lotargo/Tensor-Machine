(require 'sb-bsd-sockets)
(require 'sb-concurrency)

(load "router/protocol.lisp")
(load "router/safe_eval.lisp")
(load "router/graph.lisp")
(load "router/dsp.lisp")
(load "router/qsim.lisp")

(require 'asdf)

(defpackage :tcbp-server
  (:use :cl :tcbp :sb-bsd-sockets :safe-eval :tcbp-graph :tcbp-dsp :tcbp-qsim)
  (:export :start-server :matrix-multiply))

(in-package :tcbp-server)

(defvar *max-payload-bytes* (* 10 1024 1024))
(defvar *max-connections* 100)
(defvar *active-connections* 0)
(defvar *connections-lock* (sb-thread:make-mutex :name "connections-lock"))

(defvar *prolog-pool-size* 5)
(defvar *prolog-pool* nil)
(defvar *prolog-pool-mutex* (sb-thread:make-mutex :name "prolog-pool-mutex"))
(defvar *prolog-pool-cv* (sb-thread:make-waitqueue :name "prolog-pool-cv"))

(defun spawn-prolog-process ()
  (sb-ext:run-program "swipl"
                      '("-q" "-s" "router/solver.pl" "-g" "read_and_solve_loop, halt.")
                      :input :stream :output :stream :wait nil :search t))

(defun init-prolog-pool ()
  (setf *prolog-pool* nil)
  (dotimes (i *prolog-pool-size*)
    (push (spawn-prolog-process) *prolog-pool*))
  (format t "Prolog pool initialised with ~D processes~%" *prolog-pool-size*))

(defun destroy-prolog-pool ()
  (sb-thread:with-mutex (*prolog-pool-mutex*)
    (dolist (proc *prolog-pool*)
      (ignore-errors
        (sb-ext:process-kill proc 9)
        (sb-ext:process-close proc)))
    (setf *prolog-pool* nil)))

(defun acquire-prolog-process ()
  (sb-thread:with-mutex (*prolog-pool-mutex*)
    (loop while (null *prolog-pool*)
          do (sb-thread:condition-wait *prolog-pool-cv* *prolog-pool-mutex*))
    (pop *prolog-pool*)))

(defun release-prolog-process (proc)
  (sb-thread:with-mutex (*prolog-pool-mutex*)
    (push proc *prolog-pool*)
    (sb-thread:condition-notify *prolog-pool-cv*)))

(defmacro with-prolog-process (&body body)
  (let ((proc-var (gensym "PROC")))
    `(let ((,proc-var (acquire-prolog-process)))
       (unwind-protect
            (let ((*prolog-process* ,proc-var))
              ,@body)
         (release-prolog-process ,proc-var)))))

(defvar *prolog-process* nil)

(defun run-prolog (expr)
  (with-prolog-process
    (let ((proc *prolog-process*))
      (write-line expr (sb-ext:process-input proc))
      (force-output (sb-ext:process-input proc))
      (let ((result (read-line (sb-ext:process-output proc) nil "error")))
        result))))

(defun run-apl-coprocessor (payload)
  (let ((socket (make-instance 'inet-socket :type :stream :protocol :tcp)))
    (handler-case
        (progn
          (socket-connect socket #(127 0 0 1) 8444)
          (sb-ext:with-timeout 10
            (let ((stream (socket-make-stream socket :input t :output t :element-type '(unsigned-byte 8))))
              (write-sequence payload stream)
              (force-output stream)
              (let* ((resp-num-dims (read-byte stream))
                     (resp-dim-bytes (make-array (* resp-num-dims 4) :element-type '(unsigned-byte 8)))
                     (_ (read-sequence resp-dim-bytes stream))
                     (total-elements 1))
                (declare (ignore _))
                (dotimes (i resp-num-dims)
                  (let ((dim (unpack-uint32-le resp-dim-bytes (* i 4))))
                    (setf total-elements (* total-elements dim))))
                (let ((resp-data-bytes (make-array (* total-elements 8) :element-type '(unsigned-byte 8))))
                  (read-sequence resp-data-bytes stream)
                  (let ((full-resp (make-array (+ 1 (* resp-num-dims 4) (* total-elements 8)) :element-type '(unsigned-byte 8))))
                    (setf (aref full-resp 0) resp-num-dims)
                    (replace full-resp resp-dim-bytes :start1 1)
                    (replace full-resp resp-data-bytes :start1 (+ 1 (* resp-num-dims 4)))
                    full-resp))))))
      (end-of-file () (make-array 0 :element-type '(unsigned-byte 8)))
      (error (e)
        (format t "Error connecting to APL: ~A~%" e)
        (make-array 0 :element-type '(unsigned-byte 8))))))

(defun matrix-multiply (dims data)
  (if (not (= (length dims) 2))
      (return-from matrix-multiply data))
  (let* ((rows (aref dims 0))
         (cols (aref dims 1))
         (res (make-array (* rows cols) :element-type 'double-float)))
    (if (not (= rows cols))
        (return-from matrix-multiply data))
    ;; Blocked matrix multiplication (tile size 32)
    (let ((tile-size 32))
      (loop for i from 0 below rows by tile-size do
        (loop for j from 0 below cols by tile-size do
          (loop for k from 0 below cols by tile-size do
            (loop for ii from i below (min (+ i tile-size) rows) do
              (loop for jj from j below (min (+ j tile-size) cols) do
                (let ((sum 0.0d0))
                  (loop for kk from k below (min (+ k tile-size) cols) do
                    (let ((a (aref data (+ (* ii cols) kk)))
                          (b (aref data (+ (* kk cols) jj))))
                      (incf sum (* a b))))
                  (incf (aref res (+ (* ii cols) jj)) sum))))))))
    res))

(defun process-request (buffer length)
  (if (< length 5)
      (return-from process-request (make-array 0 :element-type '(unsigned-byte 8))))
  (let* ((opcode (aref buffer 0))
         (payload-size (unpack-uint32-le buffer 1)))
    (if (< length (+ 5 payload-size 2))
        (return-from process-request (make-array 0 :element-type '(unsigned-byte 8))))
    (when (> payload-size *max-payload-bytes*)
      (let ((err-msg "Payload exceeds maximum allowed size"))
        (return-from process-request (tcbp:pack-message opcode (map '(vector (unsigned-byte 8)) #'char-code err-msg)))))

    ;; Verify CRC16
    (let* ((crc-offset (+ 5 payload-size))
           (crc (tcbp:crc16 buffer crc-offset))
           (sent-crc (tcbp:unpack-uint16-le buffer crc-offset)))
      (unless (= crc sent-crc)
        (let ((err-msg "CRC16 validation failed"))
          (return-from process-request (tcbp:pack-message opcode (map '(vector (unsigned-byte 8)) #'char-code err-msg))))))

    (let ((payload (subseq buffer 5 (+ 5 payload-size))))
      (cond
        ((= opcode tcbp:*op-eval*)
         (let* ((expr-str (map 'string #'code-char payload))
                (result (handler-case
                            (safe-eval:evaluate expr-str)
                          (error (e) (format nil "Error: ~A" e))))
                (resp-str (format nil "~A" result))
                (resp-payload (map '(vector (unsigned-byte 8)) #'char-code resp-str)))
           (tcbp:pack-message opcode resp-payload)))
        ((= opcode tcbp:*op-solve*)
         (let* ((expr-str (map 'string #'code-char (subseq payload 0 payload-size)))
                (result (run-prolog (string-trim '(#\Space #\Newline) expr-str)))
                (resp-payload (map '(vector (unsigned-byte 8)) #'char-code result)))
           (tcbp:pack-message opcode resp-payload)))
        ((= opcode tcbp:*op-matrix*)
         (let* ((parsed (tcbp:parse-matrix-payload payload))
                (dims (first parsed))
                (data (second parsed)))
           (let ((apl-result (ignore-errors (run-apl-coprocessor payload))))
             (if (and apl-result (> (length apl-result) 0))
                 (tcbp:pack-message opcode apl-result)
                 (let ((res-data (matrix-multiply dims data)))
                   (tcbp:pack-message opcode (tcbp:pack-matrix-payload dims res-data)))))))
        ((= opcode tcbp:*op-sym*)
         (let* ((expr-str (map 'string #'code-char payload))
                (comma-pos (position #\, expr-str))
                (func (subseq expr-str 0 comma-pos))
                (var (subseq expr-str (1+ comma-pos)))
                (result (handler-case
                            (safe-eval:differentiate func var)
                          (error (e) (format nil "Error: ~A" e))))
                (resp-payload (map '(vector (unsigned-byte 8)) #'char-code result)))
           (tcbp:pack-message opcode resp-payload)))
        ((= opcode tcbp:*op-csp*)
         (let* ((expr-str (map 'string #'code-char payload))
                (result (run-prolog (string-trim '(#\Space #\Newline) expr-str)))
                (resp-payload (map '(vector (unsigned-byte 8)) #'char-code result)))
           (tcbp:pack-message opcode resp-payload)))
        ((= opcode tcbp:*op-graph*)
         (let* ((parsed (tcbp:parse-csr-payload payload))
                (num-nodes (first parsed))
                (row-ptrs (third parsed))
                (col-indices (fourth parsed))
                (data (fifth parsed))
                (source-node 0)
                (res (tcbp-graph:dijkstra num-nodes row-ptrs col-indices data source-node))
                (dist (first res))
                (prev (second res)))
           (tcbp:pack-message opcode (tcbp:pack-graph-payload num-nodes dist prev))))
        ((= opcode tcbp:*op-dsp*)
         (let* ((parsed (tcbp:parse-complex-payload payload))
                (num-elems (first parsed))
                (real-parts (second parsed))
                (imag-parts (third parsed))
                (res (tcbp-dsp:dft num-elems real-parts imag-parts))
                (out-real (first res))
                (out-imag (second res)))
           (tcbp:pack-message opcode (tcbp:pack-complex-payload num-elems out-real out-imag))))
        ((= opcode tcbp:*op-qsim*)
         (let* ((parsed (tcbp:parse-qsim-payload payload))
                (num-states (first parsed))
                (state-complex (second parsed))
                (num-qubits (round (log num-states 2)))
                (res (tcbp-qsim:apply-gate "H" state-complex 0 0 num-qubits)))
           (tcbp:pack-message opcode (tcbp:pack-qsim-payload num-states res))))
        (t (make-array 0 :element-type '(unsigned-byte 8)))))))

(defun handle-client (stream)
  (handler-case
      (let* ((header (make-array 5 :element-type '(unsigned-byte 8)))
             (header-bytes-read (read-sequence header stream)))
        (when (= header-bytes-read 5)
          (let* ((payload-size (unpack-uint32-le header 1))
                 (payload-and-crc (make-array (+ payload-size 2) :element-type '(unsigned-byte 8)))
                 (payload-bytes-read (read-sequence payload-and-crc stream)))
            (when (= payload-bytes-read (+ payload-size 2))
              (let* ((buffer (make-array (+ 5 payload-size 2) :element-type '(unsigned-byte 8))))
                (replace buffer header :start1 0)
                (replace buffer payload-and-crc :start1 5)
                (let ((response (process-request buffer (length buffer))))
                  (when (> (length response) 0)
                    (write-sequence response stream)
                    (force-output stream))))))))
    (end-of-file () nil)
    (error (e) (format t "Client handler error: ~A~%" e))))

(defun start-server (&optional (port 8443))
  (init-prolog-pool)
  (unwind-protect
       (let ((socket (make-instance 'inet-socket :type :stream :protocol :tcp)))
         (setf (sockopt-reuse-address socket) t)
         (socket-bind socket #(127 0 0 1) port)
         (socket-listen socket 5)
         (format t "Server listening on port ~A~%" port)
         (loop
            (let* ((client-socket (socket-accept socket))
                   (conn-allowed nil))
              (sb-thread:with-mutex (*connections-lock*)
                (if (>= *active-connections* *max-connections*)
                    (socket-close client-socket)
                    (progn (incf *active-connections*)
                           (setf conn-allowed t))))
               (when conn-allowed
                 (format t "Accepted connection~%")
                 (sb-thread:make-thread (lambda ()
                                          (unwind-protect
                                               (sb-ext:with-timeout 30
                                                 (let ((stream (socket-make-stream client-socket :input t :output t :element-type '(unsigned-byte 8))))
                                                   (handler-case
                                                       (handle-client stream)
                                                     (error (e) (format t "Client error: ~A~%" e)))
                                                   (close stream)))
                                            (socket-close client-socket)
                                            (sb-thread:with-mutex (*connections-lock*)
                                              (decf *active-connections*))))
                                    :name (format nil "client-thread"))))))
    (destroy-prolog-pool)))
