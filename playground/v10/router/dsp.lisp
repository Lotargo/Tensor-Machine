(defpackage :tcbp-dsp
  (:use :cl)
  (:export :dft))

(in-package :tcbp-dsp)

(defun dft (num-elems real-parts imag-parts)
  (let ((out-real (make-array num-elems :element-type 'double-float))
        (out-imag (make-array num-elems :element-type 'double-float)))
    (labels ((power-of-two-p (n)
               (and (not (zerop n)) (zerop (logand n (1- n)))))
             (log2 (n)
               (1- (integer-length n)))
             (bit-reverse (n bits)
               (let ((rev 0))
                 (dotimes (i bits rev)
                   (setf rev (ash rev 1))
                   (unless (zerop (logand n 1))
                     (setf rev (logior rev 1)))
                   (setf n (ash n -1)))))
             (fft (n real-in imag-in real-out imag-out)
               (let ((bits (log2 n)))
                 (dotimes (i n)
                   (let ((j (bit-reverse i bits)))
                     (setf (aref real-out i) (aref real-in j))
                     (setf (aref imag-out i) (aref imag-in j)))))
               (loop for len = 2 then (* len 2) while (<= len n) do
                 (let* ((half (/ len 2))
                        (step (/ (- pi) half)))
                   (dotimes (i half)
                     (let ((w-real (cos (* step i)))
                           (w-imag (sin (* step i))))
                       (loop for j from i below n by len do
                         (let ((k (+ j half)))
                           (let ((t-real (- (* w-real (aref real-out k))
                                           (* w-imag (aref imag-out k))))
                                 (t-imag (+ (* w-real (aref imag-out k))
                                           (* w-imag (aref real-out k)))))
                             (setf (aref real-out k)
                                   (- (aref real-out j) t-real))
                             (setf (aref imag-out k)
                                   (- (aref imag-out j) t-imag))
                             (setf (aref real-out j)
                                   (+ (aref real-out j) t-real))
                             (setf (aref imag-out j)
                                   (+ (aref imag-out j) t-imag)))))))))))
      (if (power-of-two-p num-elems)
          (fft num-elems real-parts imag-parts out-real out-imag)
          (dotimes (k num-elems)
            (let ((sum-real 0.0d0) (c-real 0.0d0)
                  (sum-imag 0.0d0) (c-imag 0.0d0))
              (dotimes (n num-elems)
                (let* ((angle (/ (* -2.0d0 pi k n) num-elems))
                       (cos-val (cos angle))
                       (sin-val (sin angle))
                       (in-r (aref real-parts n))
                       (in-i (aref imag-parts n))
                       (val-r (- (* in-r cos-val) (* in-i sin-val)))
                       (val-i (+ (* in-r sin-val) (* in-i cos-val))))
                  (let* ((y-real (- val-r c-real))
                         (t-real (+ sum-real y-real)))
                    (setf c-real (- (- t-real sum-real) y-real))
                    (setf sum-real t-real))
                  (let* ((y-imag (- val-i c-imag))
                         (t-imag (+ sum-imag y-imag)))
                    (setf c-imag (- (- t-imag sum-imag) y-imag))
                    (setf sum-imag t-imag))))
              (setf (aref out-real k) sum-real)
              (setf (aref out-imag k) sum-imag)))))
    (list out-real out-imag)))
