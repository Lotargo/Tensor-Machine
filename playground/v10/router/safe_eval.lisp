(defpackage :safe-eval
  (:use :cl)
  (:export :evaluate :differentiate))

(in-package :safe-eval)

(defun safe-math-function-p (sym)
  (member sym '(+ - * / sin cos tan sqrt abs)))

(defun safe-eval (form)
  (cond
    ((numberp form) form)
    ((and (listp form) (symbolp (car form)) (safe-math-function-p (car form)))
      (let ((args (mapcar #'safe-eval (cdr form))))
        (apply (car form) args)))
    (t (error "Unsafe or unsupported expression: ~A" form))))

(defun parse-safe (str)
  (let ((pos 0)
        (len (length str)))
    (labels
        ((skip-ws ()
           (loop while (and (< pos len)
                            (member (char str pos)
                                    '(#\space #\newline #\tab #\return)
                                    :test #'char=))
                 do (incf pos)))
         (peek ()
           (if (< pos len) (char str pos) nil))
         (expect (ch)
           (unless (and (< pos len) (char= (char str pos) ch))
             (error "Expected '~A' at position ~A" ch pos))
           (incf pos))
         (parse-token ()
           (let ((start pos))
             (loop while (and (< pos len)
                              (not (member (char str pos)
                                           '(#\space #\newline #\tab #\return #\( #\))
                                           :test #'char=)))
                   do (incf pos))
              (let ((token (subseq str start pos)))
                (multiple-value-bind (num end)
                    (parse-integer token :junk-allowed t)
                  (if (and num (= end (length token)))
                      num
                      (multiple-value-bind (fval fend)
                           (let ((*read-eval* nil))
                             (read-from-string token))
                        (if (and (floatp fval) (= fend (length token)))
                            fval
                            (intern (string-upcase token) :safe-eval))))))))
         (parse-list ()
           (expect #\()
           (let ((items nil))
             (loop
               (skip-ws)
               (when (eql (peek) #\))
                 (return))
               (push (parse-form) items))
             (expect #\))
             (nreverse items)))
         (parse-form ()
           (skip-ws)
           (case (peek)
             (#\( (parse-list))
             (#\) (error "Unexpected closing parenthesis"))
             ((nil) (error "Unexpected end of expression"))
             (otherwise (parse-token)))))
      (skip-ws)
      (let ((result (parse-form)))
        (skip-ws)
        (when (peek)
          (error "Trailing content after expression"))
        result))))

(defun evaluate (expr-str)
  (safe-eval (parse-safe expr-str)))

(defun diff (expr var)
  (cond
    ((numberp expr) 0)
    ((symbolp expr)
     (if (eq expr var) 1 0))
    ((listp expr)
     (let ((op (car expr))
           (args (cdr expr)))
       (case op
         (+ `(+ ,(diff (first args) var) ,(diff (second args) var)))
         (- `(- ,(diff (first args) var) ,(diff (second args) var)))
         (* `(+ (* ,(diff (first args) var) ,(second args))
                (* ,(first args) ,(diff (second args) var))))
         (/ `(/ (- (* ,(diff (first args) var) ,(second args))
                   (* ,(first args) ,(diff (second args) var)))
                (* ,(second args) ,(second args))))
         (sin `(* (cos ,(first args)) ,(diff (first args) var)))
         (cos `(* (- (sin ,(first args))) ,(diff (first args) var)))
         (otherwise (error "Unsupported diff op: ~A" op)))))
    (t (error "Unsupported diff expr: ~A" expr))))

(defun simplify (expr)
  (if (listp expr)
      (let ((op (car expr))
            (args (mapcar #'simplify (cdr expr))))
        (cond
          ((and (eq op '+) (equal args '(0 0))) 0)
          ((and (eq op '+) (equal (first args) 0)) (second args))
          ((and (eq op '+) (equal (second args) 0)) (first args))
          ((and (eq op '-) (equal args '(0 0))) 0)
          ((and (eq op '-) (equal (second args) 0)) (first args))
          ((and (eq op '*) (or (equal (first args) 0) (equal (second args) 0))) 0)
          ((and (eq op '*) (equal (first args) 1)) (second args))
          ((and (eq op '*) (equal (second args) 1)) (first args))
          ((and (eq op '/) (equal (first args) 0)) 0)
          ((and (numberp (first args)) (numberp (second args)))
           (case op
             (+ (+ (first args) (second args)))
             (- (- (first args) (second args)))
             (* (* (first args) (second args)))
             (/ (/ (first args) (second args)))
             (otherwise (cons op args))))
          (t (cons op args))))
      expr))

(defun differentiate (expr-str var-str)
  (let* ((expr (parse-safe expr-str))
         (var (parse-safe var-str))
         (derived (diff expr var))
         (simplified (simplify (simplify (simplify derived)))))
    (format nil "~A" simplified)))
