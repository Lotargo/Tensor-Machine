(defpackage :tcbp-graph
  (:use :cl)
  (:export :dijkstra))

(in-package :tcbp-graph)

(defun dijkstra (num-nodes row-ptrs col-indices data source)
  (let ((dist (make-array num-nodes :element-type 'double-float :initial-element most-positive-double-float))
        (visited (make-array num-nodes :element-type 'bit :initial-element 0))
        (prev (make-array num-nodes :initial-element -1))
        (heap (make-array (max num-nodes 1024)))
        (heap-size 0))
    (labels ((heap-parent (i) (floor (1- i) 2))
             (heap-left (i) (1+ (* 2 i)))
             (heap-right (i) (+ 2 (* 2 i)))
           (heap-swap (i j)
             (rotatef (aref heap i) (aref heap j)))
           (heap-push (v d)
             (when (>= heap-size (length heap))
               (let ((new-heap (make-array (* 2 (length heap)))))
                 (replace new-heap heap)
                 (setf heap new-heap)))
             (let* ((i heap-size)
                    (cell (cons d v)))
               (setf (aref heap i) cell)
               (incf heap-size)
               (loop while (> i 0)
                     for p = (heap-parent i)
                     while (< (car (aref heap i)) (car (aref heap p)))
                     do (heap-swap i p)
                        (setf i p))))
           (heap-pop ()
             (when (zerop heap-size)
               (return-from heap-pop nil))
             (let ((min-cell (aref heap 0)))
               (decf heap-size)
               (setf (aref heap 0) (aref heap heap-size))
               (let ((i 0))
                 (loop
                   (let* ((l (heap-left i))
                          (r (heap-right i))
                          (smallest i))
                     (when (and (< l heap-size)
                                (< (car (aref heap l)) (car (aref heap smallest))))
                       (setf smallest l))
                     (when (and (< r heap-size)
                                (< (car (aref heap r)) (car (aref heap smallest))))
                       (setf smallest r))
                     (when (= smallest i) (return))
                     (heap-swap i smallest)
                     (setf i smallest))))
               min-cell)))
      (setf (aref dist source) 0.0d0)
      (heap-push source 0.0d0)
      (loop
        for cell = (heap-pop)
        while cell
        do
        (let ((u (cdr cell))
              (udist (car cell)))
          (when (= (aref visited u) 0)
            (setf (aref visited u) 1)
            (let ((start-idx (aref row-ptrs u))
                  (end-idx (if (= u (1- num-nodes))
                              (length col-indices)
                              (aref row-ptrs (1+ u)))))
              (loop for i from start-idx below end-idx do
                (let ((v (aref col-indices i))
                      (weight (aref data i)))
                  (when (= (aref visited v) 0)
                    (let ((alt (+ udist weight)))
                      (when (< alt (aref dist v))
                        (setf (aref dist v) alt)
                        (setf (aref prev v) u)
                        (heap-push v alt))))))))))
      (list dist prev))))
