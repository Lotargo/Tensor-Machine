(defpackage :tcbp
  (:use :cl)
  (:export :*op-eval* :*op-matrix* :*op-solve*
           :*op-sym* :*op-graph* :*op-dsp* :*op-qsim* :*op-csp*
           :crc16 :pack-uint32-le :unpack-uint32-le :unpack-uint16-le :pack-uint16-le
           :pack-message :double-to-bytes :bytes-to-double :parse-matrix-payload :pack-matrix-payload
           :parse-csr-payload :pack-csr-payload :parse-complex-payload :pack-complex-payload
           :pack-graph-payload :parse-graph-payload :pack-qsim-payload :parse-qsim-payload))

(in-package :tcbp)

(defparameter *op-eval* 1)
(defparameter *op-matrix* 2)
(defparameter *op-solve* 3)
(defparameter *op-sym* 4)
(defparameter *op-graph* 5)
(defparameter *op-dsp* 6)
(defparameter *op-qsim* 7)
(defparameter *op-csp* 8)

(defun crc16 (bytes &optional (length (length bytes)))
  (let ((crc #xFFFF))
    (dotimes (i length)
      (setf crc (logxor crc (ash (aref bytes i) 8)))
      (dotimes (j 8)
        (if (not (zerop (logand crc #x8000)))
            (setf crc (logand #xFFFF (logxor (ash crc 1) #x1021)))
            (setf crc (logand #xFFFF (ash crc 1))))))
    crc))

(defun pack-uint32-le (val)
  (let ((bytes (make-array 4 :element-type '(unsigned-byte 8))))
    (setf (aref bytes 0) (logand val #xFF)
          (aref bytes 1) (logand (ash val -8) #xFF)
          (aref bytes 2) (logand (ash val -16) #xFF)
          (aref bytes 3) (logand (ash val -24) #xFF))
    bytes))

(defun unpack-uint32-le (bytes offset)
  (+ (aref bytes offset)
     (ash (aref bytes (+ offset 1)) 8)
     (ash (aref bytes (+ offset 2)) 16)
     (ash (aref bytes (+ offset 3)) 24)))

(defun pack-uint16-le (val)
  (let ((bytes (make-array 2 :element-type '(unsigned-byte 8))))
    (setf (aref bytes 0) (logand val #xFF)
          (aref bytes 1) (logand (ash val -8) #xFF))
    bytes))

(defun unpack-uint16-le (bytes offset)
  (+ (aref bytes offset)
     (ash (aref bytes (+ offset 1)) 8)))

(defun double-to-bytes (df)
  (let ((lo (sb-kernel:double-float-low-bits df))
        (hi (sb-kernel:double-float-high-bits df)))
    (let ((bytes (make-array 8 :element-type '(unsigned-byte 8))))
      (setf (aref bytes 0) (logand lo #xFF)
            (aref bytes 1) (logand (ash lo -8) #xFF)
            (aref bytes 2) (logand (ash lo -16) #xFF)
            (aref bytes 3) (logand (ash lo -24) #xFF)
            (aref bytes 4) (logand hi #xFF)
            (aref bytes 5) (logand (ash hi -8) #xFF)
            (aref bytes 6) (logand (ash hi -16) #xFF)
            (aref bytes 7) (logand (ash hi -24) #xFF))
      bytes)))

(defun bytes-to-double (bytes offset)
  (let* ((lo (+ (aref bytes offset)
                (ash (aref bytes (+ offset 1)) 8)
                (ash (aref bytes (+ offset 2)) 16)
                (ash (aref bytes (+ offset 3)) 24)))
         (hi (+ (aref bytes (+ offset 4))
                (ash (aref bytes (+ offset 5)) 8)
                (ash (aref bytes (+ offset 6)) 16)
                (ash (aref bytes (+ offset 7)) 24))))
    (let ((signed-hi (if (>= hi #x80000000) (- hi #x100000000) hi)))
      (sb-kernel:make-double-float signed-hi lo))))

(defun pack-message (opcode payload-bytes)
  (let* ((payload-len (length payload-bytes))
         (total-len (+ 1 4 payload-len 2))
         (msg (make-array total-len :element-type '(unsigned-byte 8))))
    (setf (aref msg 0) opcode)
    (let ((len-bytes (pack-uint32-le payload-len)))
      (replace msg len-bytes :start1 1))
    (replace msg payload-bytes :start1 5)
    (let ((crc (crc16 msg (+ 5 payload-len))))
      (let ((crc-bytes (pack-uint16-le crc)))
        (replace msg crc-bytes :start1 (+ 5 payload-len))))
    msg))

(defun parse-matrix-payload (bytes)
  (let ((num-dims (aref bytes 0))
        (offset 1))
    (let ((dims (make-array num-dims :element-type 'integer)))
      (dotimes (i num-dims)
        (setf (aref dims i) (unpack-uint32-le bytes offset))
        (incf offset 4))
      (let ((num-elements (reduce #'* dims)))
        (let ((data (make-array num-elements :element-type 'double-float)))
          (dotimes (i num-elements)
            (setf (aref data i) (bytes-to-double bytes offset))
            (incf offset 8))
          (list dims data))))))

(defun pack-matrix-payload (dims data)
  (let* ((num-dims (length dims))
         (num-elements (length data))
         (payload-len (+ 1 (* num-dims 4) (* num-elements 8)))
         (bytes (make-array payload-len :element-type '(unsigned-byte 8)))
         (offset 0))
    (setf (aref bytes offset) num-dims)
    (incf offset 1)
    (dotimes (i num-dims)
      (replace bytes (pack-uint32-le (aref dims i)) :start1 offset)
      (incf offset 4))
    (dotimes (i num-elements)
      (replace bytes (double-to-bytes (aref data i)) :start1 offset)
      (incf offset 8))
    bytes))

(defun parse-csr-payload (bytes)
  (if (< (length bytes) 8) (error "CSR payload too small"))
  (let* ((num-rows (unpack-uint32-le bytes 0))
         (num-cols (unpack-uint32-le bytes 4))
         (offset 8)
         (row-ptrs (make-array (+ num-rows 1) :element-type 'integer))
         (col-indices nil)
         (data nil))
    (if (< (length bytes) (+ offset (* (+ num-rows 1) 4))) (error "CSR payload size mismatch"))
    (dotimes (i (+ num-rows 1))
      (setf (aref row-ptrs i) (unpack-uint32-le bytes offset))
      (incf offset 4))
    (let ((num-nnz (aref row-ptrs num-rows)))
      (if (< (length bytes) (+ offset (* num-nnz 4) (* num-nnz 8))) (error "CSR payload size mismatch"))
      (setf col-indices (make-array num-nnz :element-type 'integer))
      (dotimes (i num-nnz)
        (setf (aref col-indices i) (unpack-uint32-le bytes offset))
        (incf offset 4))
      (setf data (make-array num-nnz :element-type 'double-float))
      (dotimes (i num-nnz)
        (setf (aref data i) (bytes-to-double bytes offset))
        (incf offset 8))
      (list num-rows num-cols row-ptrs col-indices data))))

(defun pack-csr-payload (num-rows num-cols row-ptrs col-indices data)
  (let* ((num-nnz (length data))
         (payload-len (+ 8 (* (+ num-rows 1) 4) (* num-nnz 4) (* num-nnz 8)))
         (bytes (make-array payload-len :element-type '(unsigned-byte 8)))
         (offset 0))
    (replace bytes (pack-uint32-le num-rows) :start1 offset)
    (incf offset 4)
    (replace bytes (pack-uint32-le num-cols) :start1 offset)
    (incf offset 4)
    (dotimes (i (+ num-rows 1))
      (replace bytes (pack-uint32-le (aref row-ptrs i)) :start1 offset)
      (incf offset 4))
    (dotimes (i num-nnz)
      (replace bytes (pack-uint32-le (aref col-indices i)) :start1 offset)
      (incf offset 4))
    (dotimes (i num-nnz)
      (replace bytes (double-to-bytes (aref data i)) :start1 offset)
      (incf offset 8))
    bytes))

(defun parse-complex-payload (bytes)
  (if (< (length bytes) 4) (error "Complex payload too small"))
  (let* ((num-elems (unpack-uint32-le bytes 0))
         (offset 4)
         (real-parts (make-array num-elems :element-type 'double-float))
         (imag-parts (make-array num-elems :element-type 'double-float)))
    (if (< (length bytes) (+ offset (* num-elems 16))) (error "Complex payload size mismatch"))
    (dotimes (i num-elems)
      (setf (aref real-parts i) (bytes-to-double bytes offset))
      (incf offset 8)
      (setf (aref imag-parts i) (bytes-to-double bytes offset))
      (incf offset 8))
    (list num-elems real-parts imag-parts)))

(defun pack-complex-payload (num-elems real-parts imag-parts)
  (let* ((payload-len (+ 4 (* num-elems 16)))
         (bytes (make-array payload-len :element-type '(unsigned-byte 8)))
         (offset 0))
    (replace bytes (pack-uint32-le num-elems) :start1 offset)
    (incf offset 4)
    (dotimes (i num-elems)
      (replace bytes (double-to-bytes (aref real-parts i)) :start1 offset)
      (incf offset 8)
      (replace bytes (double-to-bytes (aref imag-parts i)) :start1 offset)
      (incf offset 8))
    bytes))

(defun pack-graph-payload (num-elems distances predecessors)
  (let* ((payload-len (+ 4 (* num-elems 16)))
         (bytes (make-array payload-len :element-type '(unsigned-byte 8)))
         (offset 0))
    (replace bytes (pack-uint32-le num-elems) :start1 offset)
    (incf offset 4)
    (dotimes (i num-elems)
      (replace bytes (double-to-bytes (aref distances i)) :start1 offset)
      (incf offset 8)
      (replace bytes (double-to-bytes (coerce (aref predecessors i) 'double-float)) :start1 offset)
      (incf offset 8))
    bytes))

(defun parse-qsim-payload (bytes)
  (if (< (length bytes) 4) (error "Qsim payload too small"))
  (let* ((num-states (unpack-uint32-le bytes 0))
         (offset 4)
         (state-complex (make-array num-states :element-type '(complex long-float))))
    (if (< (length bytes) (+ offset (* num-states 16))) (error "Qsim payload size mismatch"))
    (dotimes (i num-states)
      (let ((real-part (coerce (bytes-to-double bytes offset) 'long-float))
            (imag-part (coerce (bytes-to-double bytes (+ offset 8)) 'long-float)))
        (setf (aref state-complex i) (complex real-part imag-part)))
      (incf offset 16))
    (list num-states state-complex)))

(defun pack-qsim-payload (num-states state-complex)
  (let* ((payload-len (+ 4 (* num-states 16)))
         (bytes (make-array payload-len :element-type '(unsigned-byte 8)))
         (offset 0))
    (replace bytes (pack-uint32-le num-states) :start1 offset)
    (incf offset 4)
    (dotimes (i num-states)
      (let ((c (aref state-complex i)))
        (replace bytes (double-to-bytes (coerce (realpart c) 'double-float)) :start1 offset)
        (incf offset 8)
        (replace bytes (double-to-bytes (coerce (imagpart c) 'double-float)) :start1 offset)
        (incf offset 8)))
    bytes))
