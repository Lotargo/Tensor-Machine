(in-package :cognitive-engine)

(defvar *wire-counter* 0)

(defun reset-emitter ()
  (setf *wire-counter* 0))

(defun next-wire ()
  (incf *wire-counter*)
  (format nil "w~D" *wire-counter*))

(defun collect-vars (ast)
  "Recursively collects all unique variables (atoms) from the AST, excluding boolean constants and known operators."
  (let ((vars nil)
        (operators '(and or implies not gate_and gate_or gate_not true false)))
    (labels ((traverse (node)
               (cond
                 ((null node) nil)
                 ((atom node)
                  (unless (member node operators)
                    (pushnew node vars)))
                 (t
                  ;; It's a list: first element is operator, rest are args
                  (mapc #'traverse (cdr node))))))
      (traverse ast))
    (sort vars #'string< :key #'symbol-name)))

(defun sanitize-identifier (sym)
  "Replaces hyphens with underscores in symbols for Verilog compliance."
  (substitute #\_ #\- (string-downcase (symbol-name sym))))

(defun emit-expr (ast stream)
  "Recursively emits Verilog code for the AST, returning the name of the output wire."
  (cond
    ((eq ast 'true) "1'b1")
    ((eq ast 'false) "1'b0")
    ((atom ast) (sanitize-identifier ast))
    ((listp ast)
     (let ((op (car ast))
           (args (cdr ast))
           (out-wire (next-wire)))
       (case op
         ((and gate_and)
          (cond
            ((null args)
             (format stream "  wire ~A;~%" out-wire)
             (format stream "  assign ~A = 1'b1;~%" out-wire)
             out-wire)
            ((null (cdr args))
             (emit-expr (car args) stream))
            (t
             (let* ((w1 (emit-expr (car args) stream))
                    (w2 (emit-expr (cons op (cdr args)) stream)))
               (format stream "  wire ~A;~%" out-wire)
               (format stream "  assign ~A = ~A & ~A;~%" out-wire w1 w2)
               out-wire))))
         ((or gate_or)
          (cond
            ((null args)
             (format stream "  wire ~A;~%" out-wire)
             (format stream "  assign ~A = 1'b0;~%" out-wire)
             out-wire)
            ((null (cdr args))
             (emit-expr (car args) stream))
            (t
             (let* ((w1 (emit-expr (car args) stream))
                    (w2 (emit-expr (cons op (cdr args)) stream)))
               (format stream "  wire ~A;~%" out-wire)
               (format stream "  assign ~A = ~A | ~A;~%" out-wire w1 w2)
               out-wire))))
         ((not gate_not)
          (let ((w1 (emit-expr (car args) stream)))
            (format stream "  wire ~A;~%" out-wire)
            (format stream "  assign ~A = ~~ ~A;~%" out-wire w1)
            out-wire))
         (implies
          (let ((w1 (emit-expr (car args) stream))
                (w2 (emit-expr (cadr args) stream)))
            (format stream "  wire ~A;~%" out-wire)
            (format stream "  assign ~A = (~~~A) | ~A;~%" out-wire w1 w2) ; NOT A OR B
            out-wire))
         (t
          ;; Fallback for unsupported operations (treat as just passthrough of 0 for hardware safety)
          (format stream "  wire ~A;~%" out-wire)
          (format stream "  assign ~A = 1'b0; // UNSUPPORTED OP: ~A~%" out-wire op)
          out-wire))))))

(defun emit-verilog (ast module-name filepath)
  "Generates a complete Verilog module from the Lisp AST."
  (ensure-directories-exist filepath)
  (reset-emitter)
  (let* ((inputs (collect-vars ast))
         (input-str (if inputs (format nil "~{~A~^, ~}" (mapcar #'sanitize-identifier inputs)) ""))
         (port-list (if inputs (format nil "~A, out" input-str) "out")))
    (with-open-file (stream filepath :direction :output :if-exists :supersede :if-does-not-exist :create)
      (format stream "// Autogenerated Verilog by v7 Cognitive Engine (Silicon Lowering)~%")
      (format stream "// AST: ~A~%~%" ast)
      (format stream "module ~A (~A);~%" module-name port-list)

      (when inputs
        (format stream "  input ~{~A~^, ~};~%" (mapcar #'sanitize-identifier inputs)))
      (format stream "  output out;~%~%")

      (let ((final-wire (emit-expr ast stream)))
        (format stream "~%  assign out = ~A;~%" final-wire))

      (format stream "endmodule~%"))
    (format t "[SILICON LOWERING] Generated Verilog module ~A to ~A~%" module-name filepath)))
