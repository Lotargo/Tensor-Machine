(require :asdf)
(defpackage :cognitive-engine (:use :cl))
(in-package :cognitive-engine)
(load "v7/engine/engine.lisp")
(in-package :cognitive-engine)

(format t "=== Quick IPC Validation ===~%")
(start-prolog-daemon)
(dotimes (i 5)
  (let ((ast (mutate '(seq (h q1) (seq (h q2) (h q3))))))
    (multiple-value-bind (penalty success)
        (check-with-prolog ast :synthesis *prolog-process*)
      (format t "AST[~D]: ~S => penalty=~F success=~S~%" i ast penalty success))))
(stop-prolog-daemon)
(format t "=== Done ===~%")
(sb-ext:exit)
