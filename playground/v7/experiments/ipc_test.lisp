(require :asdf)
(defpackage :cognitive-engine (:use :cl))
(in-package :cognitive-engine)
(load "v7/engine/engine.lisp")
(in-package :cognitive-engine)

(format t "=== Quick IPC Validation ===~%")
(let ((proc (uiop:launch-program (list "swipl" "-q" "-s" "v7/engine/daemon.pl")
                                  :input :stream
                                  :output :stream))
      (proc-cell (list nil)))
  (setf (car proc-cell) proc)
  (dolist (ast '((seq (h q1) (seq (h q2) (h q3)))
                 (h q1)
                 (t q1)
                 (cnot q1 q2)
                 (seq (cnot q1 q2) (seq (t q1) (h q3)))))
    (let ((penalty (check-with-prolog ast :synthesis proc-cell)))
      (if (< penalty 999.0)
          (format t "OK  ~S => ~F~%" ast penalty)
          (format t "FAIL ~S => ~F (timeout?)~%" ast penalty))))
  (uiop:terminate-process proc :urgent t))
(format t "=== Done ===~%")
(sb-ext:exit)
