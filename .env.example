# Mistral OCR API configuration
MISTRAL_API_KEY=

# Embedding model server configuration (pointing to local llama-server running multilingual-e5)
EMBEDDING_SERVER_URL=http://localhost:8080/v1/embeddings

# E5 instruction prefixes (can be customized dynamically, e.g. "query: search for: {}")
EMBEDDING_QUERY_PREFIX=query: 
EMBEDDING_PASSAGE_PREFIX=passage: 

# Vector search configuration
EMBEDDING_DIM=768
QDRANT_COLLECTION=default

# Rate limiting
MCP_RATE_LIMIT=100
MCP_RATE_LIMIT_REFILL=100.0

# MCP search controls
MCP_SEARCH_DEFAULT_TOP_K=5
MCP_SEARCH_MAX_TOP_K=20
MCP_SEARCH_MAX_RESPONSE_TOKENS=10000
MCP_READ_DOCUMENT_MAX_TOKENS=10000
TOKENIZER_MODEL=o200k_harmony

# Circuit Breakers
CB_FAILURE_THRESHOLD=5
CB_COOLDOWN_SECS=30

# VM Configuration
TENSOR_VM_BACKEND=simd
VM_MAX_INSTRUCTIONS=100000
TENSOR_VM_SOCKET_PATH=tensor_rag_vm.sock

# Core Database connection URLs
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tensor_rag
QDRANT_URL=http://localhost:6334
